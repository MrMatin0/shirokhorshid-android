<?xml version="1.0" encoding="utf-8"?>
<!-- Embedded web view loading bar. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:id="@android:id/background">
        <shape>
            <solid android:color="@color/sk_night_700" />
        </shape>
    </item>

    <item android:id="@android:id/progress">
        <clip>
            <shape>
                <gradient
                    android:startColor="@color/sk_gold"
                    android:endColor="@color/sk_green" />
            </shape>
        </clip>
    </item>

</layer-list>
