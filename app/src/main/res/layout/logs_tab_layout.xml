<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingLeft="@dimen/sk_space_m"
    android:paddingTop="@dimen/sk_space_m"
    android:paddingRight="@dimen/sk_space_m">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!--
          Discoverability for the long-press-to-copy affordance. Hidden along
          with the list when there is nothing to copy.
        -->
        <TextView
            android:id="@+id/logsCopyHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:paddingBottom="@dimen/sk_space_s"
            android:text="@string/sk_long_press_to_copy"
            android:textColor="@color/sk_text_tertiary"
            android:textSize="10sp" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerView"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingBottom="@dimen/sk_space_m"
            android:scrollbars="none" />
    </LinearLayout>

    <!--
      Empty state. A blank tab (fresh install, or straight after Clear logs)
      reads as a broken screen rather than an empty one.
    -->
    <LinearLayout
        android:id="@+id/logsEmptyState"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingLeft="@dimen/sk_space_xxl"
        android:paddingRight="@dimen/sk_space_xxl"
        android:visibility="gone"
        tools:visibility="visible">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/sk_logs_empty_title"
            android:textColor="@color/sk_text_secondary"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:lineSpacingExtra="2dp"
            android:paddingTop="@dimen/sk_space_s"
            android:text="@string/sk_logs_empty_body"
            android:textColor="@color/sk_text_tertiary"
            android:textSize="12sp" />
    </LinearLayout>
</FrameLayout>
