<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/sk_night_900"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/main_toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/sk_night_900"
        android:contentInsetStart="0dp"
        android:contentInsetLeft="0dp"
        app:contentInsetStart="0dp"
        app:contentInsetLeft="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginStart="@dimen/sk_space_l"
                android:layout_marginLeft="@dimen/sk_space_l"
                android:contentDescription="@string/app_name"
                android:src="@mipmap/ic_launcher" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/sk_space_m"
                android:layout_marginLeft="@dimen/sk_space_m"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/app_name"
                android:textColor="@color/sk_text_primary"
                android:textSize="19sp"
                android:textStyle="bold" />

        </LinearLayout>
    </com.google.android.material.appbar.MaterialToolbar>

    <View
        android:layout_width="match_parent"
        android:layout_height="@dimen/sk_stroke"
        android:background="@color/sk_outline_variant" />

    <com.psiphon3.PsiphonTabLayout
        android:id="@+id/main_activity_tablayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/sk_night_900"
        app:tabIndicator="@drawable/sk_tab_indicator"
        app:tabIndicatorColor="@color/sk_gold"
        app:tabIndicatorFullWidth="false"
        app:tabIndicatorGravity="bottom"
        app:tabIndicatorHeight="3dp"
        app:tabPaddingEnd="@dimen/sk_space_m"
        app:tabPaddingStart="@dimen/sk_space_m"
        app:tabSelectedTextColor="@color/sk_text_primary"
        app:tabTextColor="@color/sk_text_tertiary" />

    <View
        android:layout_width="match_parent"
        android:layout_height="@dimen/sk_stroke"
        android:background="@color/sk_outline_variant" />

    <!--
      CoordinatorLayout rather than a plain FrameLayout, for two reasons:
      snackbars anchored here are laid out inside the tab content area instead
      of on top of the bottom action bar (a confirmation must never cover the
      Connect button), and the help FAB gets the standard translate-out-of-the
      -way behaviour for free. It is still a ViewGroup with the same children
      and the same gravity semantics, so nothing else changes.
    -->
    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:id="@+id/main_content"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.viewpager.widget.ViewPager
            android:id="@+id/tabs_view_pager"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/help_connect_fab"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end|bottom"
            android:layout_margin="@dimen/sk_space_l"
            android:tint="@color/sk_on_gold"
            android:tooltipText="@string/help_connect_fab_tooltip"
            android:visibility="gone"
            app:backgroundTint="@color/sk_gold"
            app:fabSize="normal"
            app:maxImageSize="48dp"
            app:srcCompat="@drawable/ic_nfc_help" />
    </androidx.coordinatorlayout.widget.CoordinatorLayout>

    <!-- Bottom action bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/sk_night_800"
        android:orientation="vertical">

        <View
            android:layout_width="match_parent"
            android:layout_height="@dimen/sk_stroke"
            android:background="@color/sk_outline_variant" />

        <!--
          Both indicators live in the same slot: the horizontal progress bar is
          shown while connecting, the animated bar while waiting for a network.
        -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/sk_progress_track_height">

            <ProgressBar
                android:id="@+id/connectionProgressBar"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="@dimen/sk_progress_track_height"
                android:indeterminate="true"
                android:indeterminateTint="@color/sk_gold"
                android:visibility="invisible" />

            <LinearLayout
                android:id="@+id/connectionWaitingNetworkIndicator"
                android:layout_width="match_parent"
                android:layout_height="@dimen/sk_progress_track_height"
                android:background="@drawable/connection_waiting_network_animation_drawable"
                android:orientation="horizontal"
                android:visibility="invisible" />
        </FrameLayout>

        <LinearLayout
            android:id="@+id/buttonPanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:baselineAligned="false"
            android:orientation="horizontal"
            android:padding="@dimen/sk_space_l">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/toggleButton"
                android:layout_width="0dp"
                android:layout_height="@dimen/sk_action_button_height"
                android:layout_weight="1"
                android:ellipsize="end"
                android:insetBottom="0dp"
                android:insetTop="0dp"
                android:maxLines="1"
                android:text="@string/start"
                android:textColor="@color/sk_btn_primary_fg"
                android:textSize="15sp"
                app:backgroundTint="@color/sk_btn_primary_bg"
                app:cornerRadius="@dimen/sk_radius_pill"
                app:icon="@drawable/sk_ic_power"
                app:iconGravity="textStart"
                app:iconPadding="@dimen/sk_space_s"
                app:iconSize="@dimen/sk_action_icon_size"
                app:iconTint="@color/sk_btn_primary_fg" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/openBrowserButton"
                android:layout_width="0dp"
                android:layout_height="@dimen/sk_action_button_height"
                android:layout_marginStart="@dimen/sk_space_m"
                android:layout_marginLeft="@dimen/sk_space_m"
                android:layout_weight="1"
                android:ellipsize="end"
                android:insetBottom="0dp"
                android:insetTop="0dp"
                android:maxLines="1"
                android:text="@string/open_browser"
                android:textColor="@color/sk_text_primary"
                android:textSize="15sp"
                app:backgroundTint="@android:color/transparent"
                app:cornerRadius="@dimen/sk_radius_pill"
                app:icon="@drawable/sk_ic_open_in_new"
                app:iconGravity="textStart"
                app:iconPadding="@dimen/sk_space_s"
                app:iconSize="@dimen/sk_action_icon_size"
                app:iconTint="@color/sk_text_secondary"
                app:strokeColor="@color/sk_outline"
                app:strokeWidth="@dimen/sk_stroke" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
