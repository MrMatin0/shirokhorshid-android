<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/sk_space_xs"
    android:background="@drawable/sk_log_row"
    android:orientation="horizontal"
    android:paddingLeft="@dimen/sk_space_m"
    android:paddingTop="@dimen/sk_space_s"
    android:paddingRight="@dimen/sk_space_m"
    android:paddingBottom="@dimen/sk_space_s">

    <TextView
        android:id="@+id/MessageRow.Timestamp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/sk_space_m"
        android:layout_marginRight="@dimen/sk_space_m"
        android:fontFamily="monospace"
        android:textColor="@color/sk_text_tertiary"
        android:textIsSelectable="false"
        android:textSize="11sp"
        tools:text="18:04:22" />

    <TextView
        android:id="@+id/MessageRow.Text"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:textColor="@color/sk_text_secondary"
        android:textIsSelectable="false"
        android:textSize="12sp"
        tools:text="Connected" />
</LinearLayout>
