<?xml version="1.0" encoding="utf-8"?>
<!--
  API 35+ only: opt out of edge-to-edge enforcement.

  This used to re-declare Theme.Psiphon and Theme.Psiphon.NoActionBar from
  scratch, which silently dropped every theme attribute defined in values/.
  Now it overrides a single thin layer, so the palette is inherited.
-->
<resources>

    <style name="Base.Theme.ShirOKhorshid.Compat">
        <item name="android:windowOptOutEdgeToEdgeEnforcement">true</item>
    </style>

</resources>
